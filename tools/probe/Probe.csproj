<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />

    <!--
      The whole of Core and ViewModel, by glob rather than by list. The list drifted: files were added to the
      app and the probe stopped compiling, which is a worse failure than including one file too many. Neither
      folder touches WPF, so the glob is safe.
    -->
    <Compile Include="..\..\src\MemMop\Core\**\*.cs" LinkBase="Core" />
    <Compile Include="..\..\src\MemMop\ViewModel\**\*.cs" LinkBase="ViewModel" />
  </ItemGroup>
</Project>
