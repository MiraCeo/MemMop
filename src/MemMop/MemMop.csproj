<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>MemMop</AssemblyName>
    <RootNamespace>MemMop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <AssemblyVersion>0.4.0.0</AssemblyVersion>
    <FileVersion>0.4.0.0</FileVersion>
    <ApplicationIcon>Assets\MemMop.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- the same file the exe carries, so the window and the tray can show it too -->
    <Resource Include="Assets\MemMop.ico" />
  </ItemGroup>

</Project>
