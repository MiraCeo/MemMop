<Window x:Class="MemMop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemMop" Height="560" Width="520">
    <TabControl Margin="10">
        <TabItem Header="主页">
            <TextBlock Margin="12" Text="内存区域与进程占用（待实现）" />
        </TabItem>
        <TabItem Header="设置">
            <StackPanel Margin="12">
                <TextBlock Margin="0, 0, 0, 4" Text="语言" />
                <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>

                <CheckBox x:Name="CloseToTrayBox"
                          Margin="0, 16, 0, 0"
                          Content="关闭时最小化到托盘"
                          Checked="OnCloseToTrayChanged"
                          Unchecked="OnCloseToTrayChanged" />
            </StackPanel>
        </TabItem>
        <TabItem Header="关于">
            <TextBlock Margin="12" Text="（待实现）" />
        </TabItem>
    </TabControl>
</Window>
