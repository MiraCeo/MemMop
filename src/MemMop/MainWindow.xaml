<Window x:Class="MemMop.MainWindow"
        xmlns:controls="clr-namespace:MemMop.Controls"
        xmlns:converters="clr-namespace:MemMop.Converters"
        Topmost="{Binding AlwaysOnTop}"
        xmlns:core="clr-namespace:MemMop.Core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemMop"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontSize="{Binding FontSize}"
        Height="640"
        Width="540">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibility x:Key="InverseBoolToVisibility" />
    </Window.Resources>


        <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="2" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarSurface}" MouseLeftButtonDown="OnTitleBarMouseDown">
                <!-- decorative layers; both are opacity tokens so a variant is a number, not a rewrite -->
                <Rectangle Height="2"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource Accent}"
                           IsHitTestVisible="False"
                           Opacity="{DynamicResource TitleBarAccentOpacity}" />
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="#FFFFFF"
                           IsHitTestVisible="False"
                           Opacity="{DynamicResource TitleBarHighlightOpacity}" />
                <TextBlock Margin="22, 0, 0, 0"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="忆干二净 MemMop" />

                <StackPanel Margin="0, 0, 6, 0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding AlwaysOnTop}"
                                  ToolTip="窗口置顶">
                        <Path Data="M 2.2 1.6 L 9.8 1.6 L 9.8 4.2 L 6.9 6.2 L 6.9 10.8 L 5.1 10.8 L 5.1 6.2 L 2.2 4.2 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </ToggleButton>

                    <ToggleButton x:Name="CompactToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding CompactMode}"
                                  ToolTip="紧凑视图">
                        <Path Data="M 2 8 L 6 3.5 L 10 8"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </ToggleButton>

                    <Button Style="{StaticResource TitleButton}" Click="OnMinimizeClick" ToolTip="最小化">
                        <Path Data="M 2 6 L 10 6"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </Button>

                    <Button Style="{StaticResource TitleButton}" Click="OnCloseClick" ToolTip="关闭">
                        <Path Data="M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
        <Grid x:Name="CompactPanel"
              Margin="12"
              Visibility="{Binding CompactMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:RingChart Width="132"
                                Height="132"
                                Palette="{DynamicResource SegmentPalette}"
                                RingThickness="16"
                                Values="{Binding PhysicalSegments}" />

            <StackPanel Grid.Column="1" Margin="14, 4, 0, 0" VerticalAlignment="Top">
                <TextBlock FontSize="26" Text="{Binding UsedPercentText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding UsedText}" />
                <TextBlock Margin="0, 14, 0, 0" Foreground="#E2523B" Text="{Binding ActiveText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#9E9E9E" Text="{Binding ModifiedText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#A5D66A" Text="{Binding StandbyText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#43B047" Text="{Binding FreeText}" />
            </StackPanel>
        </Grid>

    <TabControl x:Name="Tabs"
                Margin="0"
                Visibility="{Binding CompactMode, Converter={StaticResource InverseBoolToVisibility}}">
        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Home}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="22, 18, 22, 10">

                        <TextBlock FontSize="21" Text="{Binding PhysicalText}" />

                        <controls:ProportionBar Height="10"
                                                Margin="0, 16, 0, 0"
                                                Palette="{DynamicResource SegmentPalette}"
                                                Values="{Binding PhysicalSegments}" />
                        <TextBlock Margin="0, 9, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding SegmentText}"
                                   Visibility="{Binding DetailedMemory, Converter={StaticResource BoolToVisibility}}" />

                        <controls:ProportionBar Height="6"
                                                Margin="0, 14, 0, 0"
                                                Palette="{DynamicResource CommitPalette}"
                                                Values="{Binding CommitSegments}" />
                        <TextBlock Margin="0, 9, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding CommitText}"
                                   Visibility="{Binding ShowCommitted, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Margin="0, 22, 0, 10"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="清理区域" />

                        <ItemsControl ItemsSource="{Binding Areas}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0, 0, 0, 14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0"
                                                  Margin="0, 1, 0, 0"
                                                  VerticalAlignment="Top"
                                                  IsChecked="{Binding IsSelected}" />

                                        <StackPanel Grid.Column="1" Margin="10, 0, 0, 0">
                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                            <TextBlock Margin="0, 3, 0, 0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Risk}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="2"
                                                   Margin="12, 0, 0, 0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding LastResult}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ToggleButton Margin="0, 4, 0, 0"
                                      HorizontalAlignment="Left"
                                      Content="{Binding Source={x:Static core:Strings.Current}, Path=ProcessUsage}"
                                      IsChecked="{Binding ProcessUsageExpanded}" />

                        <StackPanel Margin="0, 10, 0, 0" Visibility="{Binding ProcessUsageExpanded, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl ItemsSource="{Binding ProcessUsageItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0, 3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12, 0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Instances}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Size}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0, 10, 0, 0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{Binding ProcessUsageTotal}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Padding="22, 12"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0, 1, 0, 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Margin="0, 0, 0, 10"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding Summary}" />

                        <Button Grid.Row="1"
                                Height="38"
                                Command="{Binding CleanCommand}"
                                Content="{Binding Source={x:Static core:Strings.Current}, Path=Clean}" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Settings}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22, 18, 22, 24">

                    <TextBlock Margin="0, 0, 0, 10" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="外观" />

                    <Grid Margin="0, 0, 0, 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="{Binding Source={x:Static core:Strings.Current}, Path=Language}" />
                        <ComboBox x:Name="LanguageBox"
                                  Grid.Column="1"
                                  Width="200"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="OnLanguageChanged">
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                            <ComboBoxItem Content="English" Tag="en" />
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0, 0, 0, 4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="字号" />
                        <ComboBox Grid.Column="1"
                                  Width="140"
                                  HorizontalAlignment="Left"
                                  SelectedIndex="{Binding FontSizeIndex}">
                            <ComboBoxItem Content="小" />
                            <ComboBoxItem Content="标准" />
                            <ComboBoxItem Content="大" />
                        </ComboBox>
                    </Grid>

                    <CheckBox Margin="0, 10, 0, 0" Content="显示已提交行" IsChecked="{Binding ShowCommitted}" />
                    <CheckBox Margin="0, 10, 0, 0" Content="显示详细内存信息" IsChecked="{Binding DetailedMemory}" />

                    <Rectangle Height="1"
                               Margin="0, 26, 0, 0"
                               Fill="{DynamicResource Border}"
                               Opacity="0.55" />

                    <TextBlock Margin="0, 22, 0, 10" FontSize="11" Foreground="{DynamicResource TextMuted}" Text="行为" />

                    <CheckBox x:Name="CloseToTrayBox"
                              Content="{Binding Source={x:Static core:Strings.Current}, Path=CloseToTray}"
                              IsChecked="{Binding CloseToTray}" />
                    <CheckBox Margin="0, 10, 0, 0" Content="静默启动（启动时不显示窗口）" IsChecked="{Binding StartMinimized}" />
                    <CheckBox Margin="0, 10, 0, 0" Content="开机自启（登录时以最高权限启动，不弹 UAC）" IsChecked="{Binding RunOnStartup}" />
                    <CheckBox Margin="0, 10, 0, 0" Content="启用清理热键（Ctrl+Alt+M）" IsChecked="{Binding HotkeyEnabled}" />

                    <Rectangle Height="1"
                               Margin="0, 26, 0, 0"
                               Fill="{DynamicResource Border}"
                               Opacity="0.55" />

                    <TextBlock Margin="0, 24, 0, 12"
                               FontSize="11"
                               Foreground="{DynamicResource TextMuted}"
                               Text="排除的进程" />
                    <TextBlock Margin="0, 0, 0, 10"
                               FontSize="10"
                               Foreground="{DynamicResource InputBorder}"
                               Text="这些进程不参与「收缩程序驻留内存」" />

                    <Grid>
                        <TextBox Margin="0, 0, 42, 0"
                                 Padding="34, 6, 10, 6"
                                 Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{Binding Source={x:Static core:Strings.Current}, Path=SearchProcess}" />
                        <Grid Width="14"
                              Height="14"
                              Margin="12, 0, 0, 0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center"
                              IsHitTestVisible="False">
                            <Ellipse Width="9"
                                     Height="9"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Top"
                                     Stroke="{DynamicResource TextMuted}"
                                     StrokeThickness="1.3" />
                            <Line X1="8"
                                  Y1="8"
                                  X2="13"
                                  Y2="13"
                                  Stroke="{DynamicResource TextMuted}"
                                  StrokeThickness="1.3" />
                        </Grid>
                    </Grid>

                    <Grid Margin="0, 10, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding AvailableProcesses}" SelectedItem="{Binding SelectedProcess}" />
                        <Button Grid.Column="1"
                                Width="34"
                                Height="32"
                                Margin="8, 0, 0, 0"
                                Command="{Binding AddExclusionCommand}"
                                Style="{StaticResource FlatButton}"
                                Content="+" />
                    </Grid>

                    <Grid Margin="0, 8, 0, 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <ListBox Height="88"
                                     ItemsSource="{Binding ExcludedProcesses}"
                                     SelectedItem="{Binding SelectedExclusion}" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{DynamicResource InputBorder}"
                                       Text="列表为空"
                                       Visibility="{Binding HasExclusions, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                        <Button Grid.Column="1"
                                Width="34"
                                Height="32"
                                Margin="8, 0, 0, 0"
                                VerticalAlignment="Top"
                                Command="{Binding RemoveExclusionCommand}"
                                Style="{StaticResource FlatButton}"
                                Content="−" />
                    </Grid>

                    <Button Margin="0, 24, 0, 0"
                            HorizontalAlignment="Left"
                            Padding="16, 7"
                            Command="{Binding ResetSettingsCommand}"
                            Content="重置为默认" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=About}">
            <StackPanel Margin="12">
                <TextBlock FontSize="18" Text="忆干二净 MemMop" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding VersionText}" />
                <TextBlock Margin="0, 14, 0, 0"
                           TextWrapping="Wrap"
                           Text="一个 Windows 内存管理工具，绿色免安装，设置保存在当前用户下。清理不会让电脑变快——待机内存本来就计入可用。" />
                <TextBlock Margin="0, 14, 0, 0"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Text="从零开始的新实现。前身是 MemMop-Archived（基于 WinMemoryCleaner 修改，GPL v3），两者的代码不共享。" />
            </StackPanel>
        </TabItem>
    </TabControl>
                </Grid>
        </Grid>
    </Border>
</Window>
