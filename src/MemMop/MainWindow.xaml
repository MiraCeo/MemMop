<Window x:Class="MemMop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemMop" Height="640" Width="540">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <TabControl x:Name="Tabs" Margin="10">
        <TabItem Header="主页">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" Text="{Binding PhysicalText}" />
                <TextBlock Grid.Row="1" Margin="0, 4, 0, 0" Foreground="#999999" Text="{Binding SegmentText}" />

                <ScrollViewer Grid.Row="2" Margin="0, 14, 0, 0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Areas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0, 0, 0, 8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                                        <TextBlock Grid.Column="1" Margin="6, 0, 0, 0" Text="{Binding Title}" />
                                        <TextBlock Grid.Column="2" Foreground="#999999" Text="{Binding LastResult}" />
                                    </Grid>
                                    <TextBlock Margin="22, 1, 0, 0"
                                               FontSize="11"
                                               Foreground="#999999"
                                               Text="{Binding Risk}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3" Margin="0, 8, 0, 0" Foreground="#999999" Text="{Binding Summary}" />
                <Button Grid.Row="4"
                        Margin="0, 8, 0, 0"
                        Padding="10, 6, 10, 6"
                        Command="{Binding CleanCommand}"
                        Content="清理" />
            </Grid>
        </TabItem>

        <TabItem Header="设置">
            <StackPanel Margin="12">
                <TextBlock Margin="0, 0, 0, 4" Text="语言" />
                <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>

                <CheckBox x:Name="CloseToTrayBox"
                          Margin="0, 16, 0, 0"
                          Content="关闭时最小化到托盘"
                          Checked="OnCloseToTrayChanged"
                          Unchecked="OnCloseToTrayChanged" />
            </StackPanel>
        </TabItem>

        <TabItem Header="关于">
            <TextBlock Margin="12" Text="（待实现）" />
        </TabItem>
    </TabControl>
</Window>
