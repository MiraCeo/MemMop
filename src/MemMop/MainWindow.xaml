<Window x:Class="MemMop.MainWindow"
        xmlns:controls="clr-namespace:MemMop.Controls"
        xmlns:converters="clr-namespace:MemMop.Converters"
        Topmost="{Binding AlwaysOnTop}"
        xmlns:core="clr-namespace:MemMop.Core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemMop"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontSize="{Binding FontSize}"
        Height="640"
        Width="540">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibility x:Key="InverseBoolToVisibility" />
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>


        <Border Background="#202020"
            BorderBrush="#303030"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="2" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseDown">
                <TextBlock Margin="12, 0, 0, 0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="#CCCCCC"
                           Text="忆干二净 MemMop" />

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding AlwaysOnTop}"
                                  ToolTip="窗口置顶">
                        <Path Data="M 2.8 1.8 L 9.2 1.8 L 9.2 4 L 6.9 5.9 L 6.9 10.6 L 5.1 10.6 L 5.1 5.9 L 2.8 4 Z"
                              Fill="Transparent"
                              Stroke="#CCCCCC"
                              StrokeThickness="1"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </ToggleButton>

                    <ToggleButton x:Name="CompactToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding CompactMode}"
                                  ToolTip="紧凑视图">
                        <Path Data="M 2 5 L 6 1 L 10 5"
                              Stroke="#CCCCCC"
                              StrokeThickness="1.4"
                              Width="12"
                              Height="8"
                              Stretch="Uniform" />
                    </ToggleButton>

                    <Button Width="34"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnMinimizeClick"
                            ToolTip="最小化">
                        <Path Data="M 2 6 L 10 6" Stroke="#CCCCCC" StrokeThickness="1.2" Width="12" Height="2" Stretch="Uniform" />
                    </Button>

                    <Button Width="34"
                            Height="28"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCloseClick"
                            ToolTip="关闭">
                        <Path Data="M 2 2 L 10 10 M 10 2 L 2 10" Stroke="#CCCCCC" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
        <Grid x:Name="CompactPanel"
              Margin="12"
              Visibility="{Binding CompactMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:RingChart Width="132"
                                Height="132"
                                Palette="{Binding PhysicalPalette}"
                                RingThickness="16"
                                Values="{Binding PhysicalSegments}" />

            <StackPanel Grid.Column="1" Margin="14, 4, 0, 0" VerticalAlignment="Top">
                <TextBlock FontSize="26" Text="{Binding UsedPercentText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding UsedText}" />
                <TextBlock Margin="0, 14, 0, 0" Foreground="#E2523B" Text="{Binding ActiveText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#9E9E9E" Text="{Binding ModifiedText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#A5D66A" Text="{Binding StandbyText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#43B047" Text="{Binding FreeText}" />
            </StackPanel>
        </Grid>

    <TabControl x:Name="Tabs"
                Margin="10"
                Visibility="{Binding CompactMode, Converter={StaticResource InverseBoolToVisibility}}">
        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Home}">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" FontSize="14" Text="{Binding PhysicalText}" />
                <StackPanel Grid.Row="1" Margin="0, 4, 0, 0">
                    <controls:ProportionBar Height="10"
                                             Margin="0, 6, 0, 0"
                                             Palette="{Binding PhysicalPalette}"
                                             Values="{Binding PhysicalSegments}" />
                    <TextBlock Foreground="#999999"
                               Text="{Binding SegmentText}"
                               Visibility="{Binding DetailedMemory, Converter={StaticResource BoolToVisibility}}" />
                    <controls:ProportionBar Height="10"
                                             Margin="0, 8, 0, 0"
                                             Palette="{Binding CommitPalette}"
                                             Values="{Binding CommitSegments}" />
                    <TextBlock Margin="0, 2, 0, 0"
                               Foreground="#999999"
                               Text="{Binding CommitText}"
                               Visibility="{Binding ShowCommitted, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <ScrollViewer Grid.Row="2" Margin="0, 14, 0, 0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Areas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0, 0, 0, 8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" />
                                        <TextBlock Grid.Column="1" Margin="6, 0, 0, 0" Text="{Binding Title}" />
                                        <TextBlock Grid.Column="2" Foreground="#999999" Text="{Binding LastResult}" />
                                    </Grid>
                                    <TextBlock Margin="22, 1, 0, 0"
                                               FontSize="11"
                                               Foreground="#999999"
                                               Text="{Binding Risk}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>


                <ToggleButton Grid.Row="3" Content="{Binding Source={x:Static core:Strings.Current}, Path=ProcessUsage}"
                              HorizontalAlignment="Left"
                              IsChecked="{Binding ProcessUsageExpanded}"
                              Margin="0, 14, 0, 0" />
                <StackPanel Grid.Row="3" Margin="0, 26, 0, 0" Visibility="{Binding ProcessUsageExpanded, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl Margin="0, 6, 0, 0" ItemsSource="{Binding ProcessUsageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0, 1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Foreground="#999999" Margin="10, 0" Text="{Binding Instances}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding Size}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0, 6, 0, 0"
                               FontSize="11"
                               Foreground="#999999"
                               Text="{Binding ProcessUsageTotal}"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Grid.Row="4" Margin="0, 8, 0, 0" Foreground="#999999" Text="{Binding Summary}" />
                <Button Grid.Row="5"
                        Margin="0, 8, 0, 0"
                        Padding="10, 6, 10, 6"
                        Command="{Binding CleanCommand}"
                        Content="{Binding Source={x:Static core:Strings.Current}, Path=Clean}" />
            </Grid>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Settings}">
            <StackPanel Margin="12">
                <TextBlock Margin="0, 0, 0, 4" Text="{Binding Source={x:Static core:Strings.Current}, Path=Language}" />
                <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="OnLanguageChanged">
                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                    <ComboBoxItem Content="English" Tag="en" />
                </ComboBox>


                <TextBlock Margin="0, 18, 0, 4" Text="{Binding Source={x:Static core:Strings.Current}, Path=Exclusions}" />
                <TextBox Padding="4"
                         Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding Source={x:Static core:Strings.Current}, Path=SearchProcess}" />
                <Grid Margin="0, 4, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox ItemsSource="{Binding AvailableProcesses}"
                              SelectedItem="{Binding SelectedProcess}" />
                    <Button Grid.Column="1"
                            Margin="6, 0, 0, 0"
                            Padding="10, 4, 10, 4"
                            Command="{Binding AddExclusionCommand}"
                            Content="+" />
                </Grid>
                <Grid Margin="0, 6, 0, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ListBox MaxHeight="120"
                             ItemsSource="{Binding ExcludedProcesses}"
                             SelectedItem="{Binding SelectedExclusion}" />
                    <Button Grid.Column="1"
                            Margin="6, 0, 0, 0"
                            Padding="10, 4, 10, 4"
                            Command="{Binding RemoveExclusionCommand}"
                            Content="-" />
                </Grid>

                <CheckBox Margin="0, 8, 0, 0"
                          Content="启用清理热键（Ctrl+C）"
                          IsChecked="{Binding HotkeyEnabled}" />

                <CheckBox Margin="0, 8, 0, 0"
                          Content="开机自启"
                          IsChecked="{Binding RunOnStartup}" />

                <CheckBox Margin="0, 8, 0, 0"
                          Content="静默启动"
                          IsChecked="{Binding StartMinimized}" />

                <CheckBox Margin="0, 8, 0, 0"
                          Content="显示已提交"
                          IsChecked="{Binding ShowCommitted}" />

                <CheckBox Margin="0, 8, 0, 0"
                          Content="详细内存信息"
                          IsChecked="{Binding DetailedMemory}" />

                <TextBlock Margin="0, 12, 0, 4" Text="字号" />
                <ComboBox Width="120" HorizontalAlignment="Left" SelectedIndex="{Binding FontSizeIndex}">
                    <ComboBoxItem Content="小" />
                    <ComboBoxItem Content="标准" />
                    <ComboBoxItem Content="大" />
                </ComboBox>

                <Button Margin="0, 16, 0, 0"
                        HorizontalAlignment="Left"
                        Padding="12, 5, 12, 5"
                        Command="{Binding ResetSettingsCommand}"
                        Content="重置" />

                <CheckBox x:Name="CloseToTrayBox"
                          Margin="0, 16, 0, 0"
                          Content="{Binding Source={x:Static core:Strings.Current}, Path=CloseToTray}"
                          Checked="OnCloseToTrayChanged"
                          Unchecked="OnCloseToTrayChanged" />
            </StackPanel>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=About}">
            <StackPanel Margin="12">
                <TextBlock FontSize="18" Text="忆干二净 MemMop" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding VersionText}" />
                <TextBlock Margin="0, 14, 0, 0"
                           TextWrapping="Wrap"
                           Text="一个 Windows 内存管理工具，绿色免安装，设置保存在当前用户下。清理不会让电脑变快——待机内存本来就计入可用。" />
                <TextBlock Margin="0, 14, 0, 0"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Text="从零开始的新实现。前身是 MemMop-Archived（基于 WinMemoryCleaner 修改，GPL v3），两者的代码不共享。" />
            </StackPanel>
        </TabItem>
    </TabControl>
                </Grid>
        </Grid>
    </Border>
</Window>
