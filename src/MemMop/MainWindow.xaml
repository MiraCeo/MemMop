<Window x:Class="MemMop.MainWindow"
        xmlns:controls="clr-namespace:MemMop.Controls"
        xmlns:converters="clr-namespace:MemMop.Converters"
        Topmost="{Binding AlwaysOnTop}"
        xmlns:core="clr-namespace:MemMop.Core"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MemMop"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        FontSize="{Binding FontSize}"
        Height="640"
        Width="540">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:InverseBoolToVisibility x:Key="InverseBoolToVisibility" />
        <converters:ActiveIndexBrush x:Key="ActiveIndexBrush" />
        <converters:ActiveIndexWeight x:Key="ActiveIndexWeight" />
    </Window.Resources>


        <Border Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Border}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" Opacity="0.45" ShadowDepth="2" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid x:Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarSurface}" MouseLeftButtonDown="OnTitleBarMouseDown">
                <!-- decorative layers; both are opacity tokens so a variant is a number, not a rewrite -->
                <Rectangle Height="2"
                           VerticalAlignment="Bottom"
                           Fill="{DynamicResource Accent}"
                           IsHitTestVisible="False"
                           Opacity="{DynamicResource TitleBarAccentOpacity}" />
                <Rectangle Height="1"
                           VerticalAlignment="Top"
                           Fill="#FFFFFF"
                           IsHitTestVisible="False"
                           Opacity="{DynamicResource TitleBarHighlightOpacity}" />
                <TextBlock Margin="22, 0, 0, 0"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimary}"
                           Text="{Binding TitleText}" />

                <StackPanel Margin="0, 0, 6, 0" HorizontalAlignment="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="PinToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding AlwaysOnTop}"
                                  ToolTip="窗口置顶">
                        <Path Data="M 2.2 1.6 L 9.8 1.6 L 9.8 4.2 L 6.9 6.2 L 6.9 10.8 L 5.1 10.8 L 5.1 6.2 L 2.2 4.2 Z"
                              Fill="Transparent"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5"
                              Width="12"
                              Height="12"
                              Stretch="Uniform" />
                    </ToggleButton>

                    <ToggleButton x:Name="CompactToggle"
                                  Width="34"
                                  Height="28"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsChecked="{Binding CompactMode}"
                                  ToolTip="紧凑视图">
                        <Path Data="M 2 8 L 6 3.5 L 10 8"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </ToggleButton>

                    <Button Style="{StaticResource TitleButton}" Click="OnMinimizeClick" ToolTip="最小化">
                        <Path Data="M 2 6 L 10 6"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </Button>

                    <Button Style="{StaticResource TitleButton}" Click="OnCloseClick" ToolTip="关闭">
                        <Path Data="M 2.5 2.5 L 9.5 9.5 M 9.5 2.5 L 2.5 9.5"
                              Width="12"
                              Height="12"
                              Stretch="None"
                              Stroke="{DynamicResource TextPrimary}"
                              StrokeThickness="1.5" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Content -->
            <Grid Grid.Row="1">
        <Grid x:Name="CompactPanel"
              Margin="12"
              Visibility="{Binding CompactMode, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Width="132" Height="132">
                <controls:RingChart Width="132"
                                    Height="132"
                                    Palette="{DynamicResource SegmentPalette}"
                                    RingThickness="16"
                                    Values="{Binding PhysicalSegments}" />
                <Button x:Name="RingCleanButton"
            Style="{StaticResource RingButton}"
                        Width="84"
                        Height="84"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Command="{Binding CleanCommand}"
                        Content="清理" />
            </Grid>

            <StackPanel Grid.Column="1" Margin="14, 4, 0, 0" VerticalAlignment="Top">
                <TextBlock FontSize="26" Text="{Binding UsedPercentText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding UsedText}" />
                <TextBlock Margin="0, 10, 0, 0" Foreground="{DynamicResource SegActive}" Text="{Binding ActiveText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="{DynamicResource SegModified}" Text="{Binding ModifiedText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="{DynamicResource SegStandby}" Text="{Binding StandbyText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="{DynamicResource SegFree}" Text="{Binding FreeText}" />
            </StackPanel>
        </Grid>

    <TabControl x:Name="Tabs"
                AlternationCount="3"
                Margin="0"
                Visibility="{Binding CompactMode, Converter={StaticResource InverseBoolToVisibility}}">
        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Home}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22, 18, 22, 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- left: the ring, then the four segments it is made of -->
                    <StackPanel Grid.Column="0" Width="150">
                        <Grid Width="132" Height="132" HorizontalAlignment="Left">
                            <controls:RingChart Width="132"
                                                Height="132"
                                                Palette="{DynamicResource SegmentPalette}"
                                                RingThickness="16"
                                                Values="{Binding PhysicalSegments}" />
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="26"
                                       Text="{Binding UsedPercentText}" />
                        </Grid>

                        <TextBlock Margin="0, 12, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding UsedText}" />

                        <TextBlock Margin="0, 10, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SegActive}"
                                   Text="{Binding ActiveText}" />
                        <TextBlock Margin="0, 3, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SegModified}"
                                   Text="{Binding ModifiedText}" />
                        <TextBlock Margin="0, 3, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SegStandby}"
                                   Text="{Binding StandbyText}" />
                        <TextBlock Margin="0, 3, 0, 0"
                                   FontSize="12"
                                   Foreground="{DynamicResource SegFree}"
                                   Text="{Binding FreeText}" />
                    </StackPanel>

                    <!-- right: who is holding it, and a way to act on one of them -->
                    <ScrollViewer Grid.Column="1"
                                  Margin="18, 0, 0, 0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="0, 0, 0, 8"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="进程占用" />

                            <ItemsControl ItemsSource="{Binding ProcessUsageItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0, 2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="1"
                                                       Margin="10, 0"
                                                       VerticalAlignment="Center"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Instances}" />

                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Size}" />

                                            <Button Grid.Column="3"
                                                    Width="20"
                                                    Height="20"
                                                    Margin="8, 0, 0, 0"
                                                    Style="{StaticResource RowAction}"
                                                    Command="{Binding DataContext.OptimizeProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Name}"
                                                    ToolTip="优化这个进程">
                                                <Path Width="9"
                                                      Height="9"
                                                      Data="M 5 1 L 5 6 M 2 3.5 L 5 6.5 L 8 3.5 M 1 9 L 9 9"
                                                      Stretch="Uniform"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.3" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Margin="0, 8, 0, 0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{Binding ProcessUsageTotal}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="2"
                        Padding="22, 12"
                        Background="{DynamicResource SurfaceAlt}"
                        BorderBrush="{DynamicResource Border}"
                        BorderThickness="0, 1, 0, 0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- only while automatic cleaning is on: it is the only place the user learns
                             why memory changed without them pressing anything -->
                        <TextBlock Grid.Row="0"
                                   Margin="0, 0, 0, 6"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding AutoCleanStatus}"
                                   Visibility="{Binding HasAutoClean, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="1"
                                   Margin="0, 0, 0, 10"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding Summary}" />

                        <Button Grid.Row="2"
                                Height="38"
                                Command="{Binding CleanCommand}"
                                Content="{Binding Source={x:Static core:Strings.Current}, Path=Clean}" />
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="统计">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22, 12, 22, 16">
                    <Border Background="{DynamicResource Nav}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="统计" />

                            <TextBlock Margin="0, 8, 0, 0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Text="内存曲线、上次清理明细、清理记录与导出。这一页还没实现，先把位置留出来。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Settings}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22, 12, 22, 16">

                    <Border Background="{DynamicResource Nav}" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Margin="0, 0, 0, 14"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="通用设置" />

                            <Grid Margin="0, 0, 0, 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock VerticalAlignment="Center" Text="语言" />
                                <ComboBox x:Name="LanguageBox"
                                          Grid.Column="1"
                                          Margin="0, 0, 16, 0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="OnLanguageChanged">
                                    <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                                    <ComboBoxItem Content="English" Tag="en" />
                                </ComboBox>

                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="字号" />
                                <ComboBox Grid.Column="3"
                                          Width="100"
                                          HorizontalAlignment="Left"
                                          SelectedIndex="{Binding FontSizeIndex}">
                                    <ComboBoxItem Content="小" />
                                    <ComboBoxItem Content="标准" />
                                    <ComboBoxItem Content="大" />
                                </ComboBox>
                            </Grid>

                            <UniformGrid Columns="2">
                                <CheckBox x:Name="CloseToTrayBox"
                                          Margin="0, 4, 16, 4"
                                          Content="{Binding Source={x:Static core:Strings.Current}, Path=CloseToTray}"
                                          IsChecked="{Binding CloseToTray}" />
                                <CheckBox Margin="0, 4" Content="静默启动" IsChecked="{Binding StartMinimized}" />
                                <CheckBox Margin="0, 4, 16, 4" Content="开机自启" IsChecked="{Binding RunOnStartup}" />
                                <CheckBox Margin="0, 4" Content="显示清理通知" IsChecked="{Binding ShowNotifications}" />
                                <CheckBox Margin="0, 4, 16, 4" Content="显示已提交" IsChecked="{Binding ShowCommitted}" />
                                <CheckBox Margin="0, 4" Content="详细内存信息" IsChecked="{Binding DetailedMemory}" />
                            </UniformGrid>

                            <CheckBox Margin="0, 8, 0, 0"
                                      Content="启用清理热键（Ctrl+Alt+M）"
                                      IsChecked="{Binding HotkeyEnabled}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0, 12, 0, 0"
                            Background="{DynamicResource Nav}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Margin="0, 0, 0, 4"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="清理区域" />

                            <TextBlock Margin="0, 0, 0, 14"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       Text="勾选要清理的项目。每项下面写的是它的代价。" />

                            <ItemsControl ItemsSource="{Binding Areas}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0, 0, 0, 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      Margin="0, 1, 0, 0"
                                                      VerticalAlignment="Top"
                                                      IsChecked="{Binding IsSelected}" />

                                            <StackPanel Grid.Column="1" Margin="10, 0, 0, 0">
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Margin="0, 3, 0, 0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="{Binding Risk}"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Margin="0, 12, 0, 0"
                            Background="{DynamicResource Nav}"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel>
                            <TextBlock Margin="0, 0, 0, 14"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       Text="自动清理" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="间隔" />

                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Slider Grid.Column="1"
                                            Style="{StaticResource SteppedSlider}"
                                            Minimum="0"
                                            Maximum="4"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AutoCleanIntervalIndex}" />
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="1" Margin="0, 4, 0, 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontSize="11" Text="关闭"
                                               FontWeight="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=0}"
                                               Foreground="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=0}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" Text="15 分"
                                               FontWeight="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=1}"
                                               Foreground="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=1}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" Text="30 分"
                                               FontWeight="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=2}"
                                               Foreground="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=2}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="11" Text="1 小时"
                                               FontWeight="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=3}"
                                               Foreground="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=3}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="11" Text="2 小时"
                                               FontWeight="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=4}"
                                               Foreground="{Binding AutoCleanIntervalIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=4}" />
                                </Grid>
                            </Grid>

                            <Grid Margin="0, 16, 0, 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="占用超过" />

                                <Grid Grid.Row="0" Grid.Column="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*" />
                                        <ColumnDefinition Width="8*" />
                                        <ColumnDefinition Width="1*" />
                                    </Grid.ColumnDefinitions>

                                    <Slider Grid.Column="1"
                                            Style="{StaticResource SteppedSlider}"
                                            Minimum="0"
                                            Maximum="4"
                                            TickFrequency="1"
                                            IsSnapToTickEnabled="True"
                                            Value="{Binding AutoCleanThresholdIndex}" />
                                </Grid>

                                <Grid Grid.Row="1" Grid.Column="1" Margin="0, 4, 0, 0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" HorizontalAlignment="Center" FontSize="11" Text="关闭"
                                               FontWeight="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=0}"
                                               Foreground="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=0}" />
                                    <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="11" Text="75%"
                                               FontWeight="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=1}"
                                               Foreground="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=1}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="11" Text="80%"
                                               FontWeight="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=2}"
                                               Foreground="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=2}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="11" Text="85%"
                                               FontWeight="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=3}"
                                               Foreground="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=3}" />
                                    <TextBlock Grid.Column="4" HorizontalAlignment="Center" FontSize="11" Text="90%"
                                               FontWeight="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexWeight}, ConverterParameter=4}"
                                               Foreground="{Binding AutoCleanThresholdIndex, Converter={StaticResource ActiveIndexBrush}, ConverterParameter=4}" />
                                </Grid>
                            </Grid>

                            <CheckBox Margin="0, 16, 0, 0"
                                      Content="只做保守操作（不收缩工作集、不压系统缓存）"
                                      IsChecked="{Binding AutoCleanSafeOnly}" />
                        </StackPanel>
                    </Border>

                    <Rectangle Height="1"
                               Margin="0, 24, 0, 0"
                               Fill="{DynamicResource Border}"
                               Opacity="0.55" />

                    <TextBlock Margin="0, 16, 0, 8"
                               FontSize="10"
                               Foreground="{DynamicResource TextMuted}"
                               Text="重置会清除所有已保存的设置" />

                    <Button Margin="0, 0, 0, 0"
                            HorizontalAlignment="Left"
                            Padding="16, 7"
                            Command="{Binding ResetSettingsCommand}"
                            Content="重置" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="{Binding Source={x:Static core:Strings.Current}, Path=Whitelist}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="22, 12, 22, 16">
                    <Border Background="{DynamicResource Nav}" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0"
                                       Grid.ColumnSpan="2"
                                       Margin="0, 0, 0, 5"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="搜索并添加进程" />

                            <!-- search: the magnifier sits inside the box, the plus adds whatever is selected -->
                            <Grid Grid.Row="1" Grid.Column="0">
                                <TextBox x:Name="SearchBox"
                                         Height="32"
                                         Padding="30, 5, 8, 5"
                                         VerticalContentAlignment="Center"
                                         GotFocus="OnSearchBoxGotFocus"
                                         Text="{Binding ProcessSearchText, UpdateSourceTrigger=PropertyChanged}" />
                                <Path Width="13"
                                      Height="13"
                                      Margin="10, 0, 0, 0"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Data="M 6 1 A 5 5 0 1 0 6 11 A 5 5 0 1 0 6 1 M 9.6 9.6 L 13 13"
                                      IsHitTestVisible="False"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource TextMuted}"
                                      StrokeThickness="1.3" />
                            </Grid>

                            <Button Grid.Row="1"
                                    Grid.Column="1"
                                    Width="32"
                                    Height="32"
                                    Margin="8, 0, 0, 0"
                                    Padding="0"
                                    Command="{Binding AddExclusionCommand}"
                                    Content="+" />

                            <TextBlock Grid.Row="2"
                                       Grid.ColumnSpan="2"
                                       Margin="0, 14, 0, 5"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="白名单（不参与清理）" />

                            <!-- every row carries its own move and delete buttons -->
                            <ListBox Grid.Row="3"
                                     Grid.ColumnSpan="2"
                                     Height="190"
                                     VerticalAlignment="Top"
                                     ItemsSource="{Binding ExcludedProcesses}"
                                     SelectedItem="{Binding SelectedExclusion}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding}" />

                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource RowAction}"
                                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="上移">
                                                    <Path Width="9"
                                                          Height="9"
                                                          Data="M 1 6 L 5 2 L 9 6"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.4" />
                                                </Button>
                                                <Button Style="{StaticResource RowAction}"
                                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="下移">
                                                    <Path Width="9"
                                                          Height="9"
                                                          Data="M 1 2 L 5 6 L 9 2"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.4" />
                                                </Button>
                                                <Button Style="{StaticResource RowAction}"
                                                        Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        ToolTip="删除">
                                                    <Path Width="9"
                                                          Height="9"
                                                          Data="M 2 2 L 8 8 M 8 2 L 2 8"
                                                          Stretch="Uniform"
                                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                          StrokeThickness="1.4" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- the candidates span the card and sit right under the box -->
                            <Grid Grid.Row="2"
                                  Grid.RowSpan="2"
                                  Grid.ColumnSpan="2"
                                  Margin="0, 4, 0, 0"
                                  VerticalAlignment="Top"
                                  Panel.ZIndex="10"
                                  Visibility="{Binding IsPickerOpen, Converter={StaticResource BoolToVisibility}}">
                                <ListBox x:Name="PickerList"
                                         MaxHeight="170"
                                         VerticalAlignment="Top"
                                         Background="{DynamicResource Surface}"
                                         BorderBrush="{DynamicResource InputBorder}"
                                         ItemsSource="{Binding AvailableProcesses}"
                                         PreviewMouseLeftButtonUp="OnPickerRowClicked"
                                         SelectedItem="{Binding SelectedProcess}" />
                                <TextBlock Height="60"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Top"
                                           Padding="0, 20, 0, 0"
                                           FontSize="11"
                                           Foreground="{DynamicResource InputBorder}"
                                           IsHitTestVisible="False"
                                           Text="无匹配的进程"
                                           Visibility="{Binding HasAvailableProcesses, Converter={StaticResource InverseBoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Tag="last" Header="{Binding Source={x:Static core:Strings.Current}, Path=About}">
            <StackPanel Margin="12">
                <TextBlock FontSize="18" Text="{Binding TitleText}" />
                <TextBlock Margin="0, 2, 0, 0" Foreground="#999999" Text="{Binding VersionText}" />
                <TextBlock Margin="0, 14, 0, 0"
                           TextWrapping="Wrap"
                           Text="一个 Windows 内存管理工具，绿色免安装，设置保存在当前用户下。清理不会让电脑变快——待机内存本来就计入可用。" />
                <TextBlock Margin="0, 14, 0, 0"
                           Foreground="#999999"
                           TextWrapping="Wrap"
                           Text="从零开始的新实现。前身是 MemMop-Archived（基于 WinMemoryCleaner 修改，GPL v3），两者的代码不共享。" />
            </StackPanel>
        </TabItem>
    </TabControl>
                </Grid>
        </Grid>
    </Border>
</Window>
