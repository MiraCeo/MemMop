<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Slate -->
    <SolidColorBrush x:Key="Surface" Color="#1E2126" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#262A31" />
    <SolidColorBrush x:Key="Hover" Color="#2F353E" />
    <SolidColorBrush x:Key="Border" Color="#343B45" />
    <SolidColorBrush x:Key="TextPrimary" Color="#E6EAF0" />
    <SolidColorBrush x:Key="TextMuted" Color="#8C97A6" />
    <SolidColorBrush x:Key="Accent" Color="#4C8DFF" />
    <SolidColorBrush x:Key="SegActive" Color="#FF6B5A" />
    <SolidColorBrush x:Key="Warn" Color="#FF6B5A" />
    <SolidColorBrush x:Key="SegModified" Color="#8C97A6" />
    <SolidColorBrush x:Key="SegStandby" Color="#4FB0C6" />
    <SolidColorBrush x:Key="SegFree" Color="#5FD38A" />
    <sys:String x:Key="SegmentPalette">#FF6B5A,#8C97A6,#4FB0C6,#5FD38A</sys:String>
    <sys:String x:Key="CommitPalette">#FF6B5A,#5FD38A</sys:String>
    <SolidColorBrush x:Key="TitleBarSurface" Color="#31363E" />
    <sys:Double x:Key="TitleBarAccentOpacity">0.6</sys:Double>
    <sys:Double x:Key="TitleBarHighlightOpacity">0</sys:Double>
    <SolidColorBrush x:Key="InputBorder" Color="#4A525E" />
    <SolidColorBrush x:Key="Nav" Color="#282C33" />
    <SolidColorBrush x:Key="TabStrip" Color="#0B0806" />
</ResourceDictionary>
