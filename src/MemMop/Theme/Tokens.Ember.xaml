<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Ember -->
    <SolidColorBrush x:Key="Surface" Color="#140F0D" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1D1613" />
    <SolidColorBrush x:Key="Hover" Color="#2A1F19" />
    <SolidColorBrush x:Key="Border" Color="#33241C" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F6EDE6" />
    <SolidColorBrush x:Key="TextMuted" Color="#A08573" />
    <SolidColorBrush x:Key="Accent" Color="#FF5F2E" />
    <SolidColorBrush x:Key="SegActive" Color="#FF5F2E" />
    <SolidColorBrush x:Key="SegModified" Color="#9C8272" />
    <SolidColorBrush x:Key="SegStandby" Color="#5F8598" />
    <SolidColorBrush x:Key="SegFree" Color="#7FA95B" />
    <SolidColorBrush x:Key="TitleBarSurface" Color="#241C18" />
    <sys:Double x:Key="TitleBarAccentOpacity">0.6</sys:Double>
    <sys:Double x:Key="TitleBarHighlightOpacity">0</sys:Double>
    <SolidColorBrush x:Key="InputBorder" Color="#573F31" />
    <SolidColorBrush x:Key="Nav" Color="#1E1714" />
</ResourceDictionary>
