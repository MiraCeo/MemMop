<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Mono -->
    <SolidColorBrush x:Key="Surface" Color="#111111" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Hover" Color="#232323" />
    <SolidColorBrush x:Key="Border" Color="#2A2A2A" />
    <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F0" />
    <SolidColorBrush x:Key="TextMuted" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Accent" Color="#7C5CFF" />
    <SolidColorBrush x:Key="SegActive" Color="#E6E6E6" />
    <SolidColorBrush x:Key="SegModified" Color="#6E6E6E" />
    <SolidColorBrush x:Key="SegStandby" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SegFree" Color="#7C5CFF" />
    <sys:String x:Key="SegmentPalette">#E6E6E6,#6E6E6E,#3A3A3A,#7C5CFF</sys:String>
    <sys:String x:Key="CommitPalette">#E6E6E6,#7C5CFF</sys:String>
    <SolidColorBrush x:Key="TitleBarSurface" Color="#232323" />
    <sys:Double x:Key="TitleBarAccentOpacity">0</sys:Double>
    <sys:Double x:Key="TitleBarHighlightOpacity">0</sys:Double>
</ResourceDictionary>
